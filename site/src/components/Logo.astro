---
// One logo, from the account's brand folder. Never recoloured or redrawn.
// Light surfaces get the full-colour file. Dark surfaces get the reversed file when there is one.
// When any logo in the lockup has no reversed file, Plate.astro puts the whole lockup on one white plate
// instead, and every logo then shows its full-colour file (see .plate[data-tile] in global.css).
import type { Logo } from '../lib/site';
import { isDev } from '../lib/site';

interface Props {
  logo: Logo;
  class?: string;
}
const { logo, class: className } = Astro.props;
---

{
  logo.missing && isDev ? (
    <span class="phlogo">Missing logo: {logo.name}</span>
  ) : (
    <span class:list={['logo', className]} data-rev={logo.reversed ? '' : undefined}>
      <img class="full" src={logo.full} alt={logo.name} decoding="async" />
      {logo.reversed && <img class="rev" src={logo.reversed} alt={logo.name} decoding="async" />}
    </span>
  )
}
