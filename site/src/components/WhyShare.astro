---
// Three short reasons to share. Used on Home only: Get started does not repeat them.
const points = [
  {
    title: 'The same approach, whoever asks',
    body: 'The way of doing a job is written down once, so it does not depend on who remembers it. Two people asking for the same thing get the same shape of answer.',
  },
  {
    title: 'Improvements reach everyone',
    body: 'There is one copy of each asset to improve, so a fix helps the whole account at once.',
  },
  {
    title: 'Faster starts for new joiners',
    body: 'A new team member picks up what the account has already learned, instead of working it out again.',
  },
];
---

<div class="three">
  {
    points.map((p) => (
      <div>
        <h3>{p.title}</h3>
        <p>{p.body}</p>
      </div>
    ))
  }
</div>
