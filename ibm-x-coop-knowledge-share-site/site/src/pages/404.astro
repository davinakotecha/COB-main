---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/site';
---

<Base title="Page not found" noSearch>
  <section class="lost">
    <div class="wrap">
      <h1>That page doesn't exist</h1>
      <p class="lede">The link may be out of date, or the address may have a typo. Try one of these instead, or press Ctrl K to search.</p>
      <div class="cta">
        <a class="btn pri" href={withBase('/')}>Go to Home</a>
        <a class="btn sec" href={withBase('/skills/')}>Browse the Skills library</a>
      </div>
    </div>
  </section>
</Base>
