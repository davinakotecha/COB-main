---
// The small chip with the account square. In neutral and IBM-only modes it says "Our account".
import { t } from '../lib/site';

interface Props {
  /** Add the line "This page belongs to this account." after the chip. */
  line?: boolean;
  /** Text for the chip instead of the account's name. Pages that every account shares use this. */
  label?: string;
}
const { line = false, label } = Astro.props;
---

<p class="acctline">
  <span class="chip"><i class="mk" aria-hidden="true"></i><span>{label ?? t.clientName}</span></span>
  {line && <span>This page belongs to this account.</span>}
</p>
