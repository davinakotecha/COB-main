---
// The signature of the generic pages: a field of small squares, faint behind the hero, that ripples in
// once from the right. A few tiles are Carbon blue. Decorative only; the real content never depends on it.
const cols = 44;
const rows = 20;
const size = 36;
const gap = 4;
const cx = cols * 0.8;
const cy = rows * 0.5;

const tiles: { x: number; y: number; d: number; cls: string }[] = [];
for (let r = 0; r < rows; r++) {
  for (let c = 0; c < cols; c++) {
    // Deterministic noise, so every build looks the same.
    const n = Math.abs(Math.sin(c * 12.9898 + r * 78.233) * 43758.5453) % 1;
    const dist = Math.sqrt((c - cx) ** 2 + (r - cy) ** 2 * 1.96);
    const hi = n > 0.94 && c > 20;
    const level = n < 0.34 ? 'o1' : n < 0.67 ? 'o2' : 'o3';
    tiles.push({ x: c * size + gap / 2, y: r * size + gap / 2, d: Math.round(dist * 45), cls: hi ? 'fl hi' : `fl ${level}` });
  }
}
---

<div class="field" aria-hidden="true">
  <svg viewBox={`0 0 ${cols * size} ${rows * size}`} preserveAspectRatio="xMidYMid slice" focusable="false">
    {tiles.map((t) => <rect class={t.cls} style={`animation-delay:${t.d}ms`} x={t.x} y={t.y} width={size - gap} height={size - gap} />)}
  </svg>
</div>
