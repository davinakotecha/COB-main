---
import Plate from './Plate.astro';
import { nav, t, config, mode, buildInfo, withBase, repoUrl } from '../lib/site';

const licence =
  mode === 'neutral'
    ? 'No open-source licence has been granted. Treat the skills as internal material.'
    : `No open-source licence has been granted. Treat the skills as internal ${config.leadBrand} and author material.`;
// "Skills updated from" is the commit of the repository the skills were read from, which is what the
// scheduled run compares against. It is the same as the site's own commit when there is only one repository.
const built = buildInfo.skillsShaShort
  ? `Skills updated from ${buildInfo.skillsShaShort}, built on ${buildInfo.date}.`
  : buildInfo.sha
    ? `Built from commit ${buildInfo.sha} on ${buildInfo.date}.`
    : `Built on ${buildInfo.date}.`;
---

<footer class="g100">
  <div class="wrap grid">
    <div style="grid-column: 1 / 10">
      <Plate />
      <p>A shared library where {t.teamPhrase} adds the skills and tools it has built, so the whole account can use them.</p>
      <p>{licence}</p>
      {config.contactRoute && <p>Questions? {config.contactRoute}</p>}
    </div>
    <div class="foot-right" style="grid-column: 10 / 17">
      <div class="flinks">
        {nav.map((n) => <a href={withBase(n.href)}>{n.label}</a>)}
        <a href={repoUrl} target="_blank" rel="noopener noreferrer">View on GitHub</a>
      </div>
      <p>{built}</p>
    </div>
  </div>
</footer>

<style>
  @media (max-width: 1056px) {
    footer .grid > div {
      grid-column: 1 / -1 !important;
    }
    .foot-right {
      margin-top: 24px;
    }
  }
</style>
