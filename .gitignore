# ============================================================
# Defense in depth: these skills must only ever be exercised
# against fictional data in examples/. Anything real stays in
# local/ and untracked, with belt-and-suspenders patterns below
# in case something real ends up outside local/ by mistake.
# ============================================================

# --- Primary sandbox for real, client-specific working files ---
/local/
/private/

# --- Block real-shaped PowerPoint decks anywhere except the ---
# --- tiny fictional fixtures under examples/ ---
*.pptx
*.potx
!examples/**/*.pptx
!examples/**/*.potx

# --- Genesys exports / Archy YAML pulled from a real org ---
*-export.json
*.archy.yaml
!examples/**/*-export.json
!examples/**/*.archy.yaml

# --- Transient unpacked OOXML working trees ---
unpacked/
**/unpacked/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- Scratch ---
*.tmp
tmp/

# --- Website (site/) ---
node_modules/
site/dist/
site/.astro/
site/src/generated/
site/src/styles/tokens.generated.css
site/public/brand/
site/public/downloads/
site/public/build.json
/template-*/
# A separate skills repository checked out by the workflow (or locally) for the build
/skills-repo/

# --- Secrets: never commit these ---
.env
.env.*
!.env.example
*.pem
*.key
