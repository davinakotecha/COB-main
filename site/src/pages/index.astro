---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Steps from '../components/Steps.astro';
import WhyShare from '../components/WhyShare.astro';
import AccountChip from '../components/AccountChip.astro';
import { withBase } from '../lib/site';

const steps = [
  { title: 'Find a skill', body: 'Browse the library. Every skill says what you give it and what you get back.' },
  { title: 'Add it to Claude', body: 'A short, one-off setup. Each skill page has the steps.' },
  { title: 'Ask Claude for the job', body: "Describe the task in plain words. Claude picks up the skill and follows the team's way of doing it." },
];
---

<Base title="Home" current="home">
  <Hero />

  <section aria-labelledby="h-why">
    <div class="wrap">
      <h2 id="h-why">Why share skills?</h2>
      <p class="sec-intro">Build it once, and the whole account benefits.</p>
      <WhyShare />
    </div>
  </section>

  <section class="band" aria-labelledby="h-how">
    <div class="wrap">
      <h2 id="h-how">How it works</h2>
      <p class="sec-intro">Using a skill takes three steps. There is nothing to build and no code to write.</p>
      <Steps items={steps} columns={3} />
      <div class="after"><a class="btn pri" href={withBase('/how-it-works/')}>Read the full walkthrough</a></div>
    </div>
  </section>

  <section aria-labelledby="h-explore">
    <div class="wrap">
      <h2 id="h-explore">Explore the account's space</h2>
      <p class="sec-intro">Two pages belong to each account: the skills the team has built, and what is planned. They are marked with a coloured square.</p>
      <AccountChip label="Account pages" />
      <div class="tiles">
        <article class="tile">
          <span class="nm plain">Skills library</span>
          <p class="tg">Skills the team has built and shared.</p>
          <p class="sub2">Each skill says what it does, what you give it, and how to add it to Claude.</p>
          <div class="acts"><a class="btn pri sm" href={withBase('/skills/')}>Open the library</a></div>
        </article>
        <article class="tile">
          <span class="nm plain">Roadmap</span>
          <p class="tg">Ideas raised, work in progress, and what is live.</p>
          <p class="sub2">See what is coming and suggest a skill of your own.</p>
          <div class="acts"><a class="btn pri sm" href={withBase('/roadmap/')}>Open the roadmap</a></div>
        </article>
      </div>
    </div>
  </section>

  <div class="bandblue">
    <div class="wrap">
      <p>Spot a task the team repeats? Turn it into a skill.</p>
      <a class="btn" href={withBase('/contribute/')}>Add a skill</a>
    </div>
  </div>
</Base>
